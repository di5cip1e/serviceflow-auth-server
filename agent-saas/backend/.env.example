# ============================================
# M.ai.K.R — Phase 3: Omnichannel API Gateway
# ============================================
# Copy this file to .env and fill in your credentials

# ── Twilio (SMS + WhatsApp) ─────────────────
# Find in twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your Twilio number (with country code, e.g. +1234567890)
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Public webhook URL Twilio calls (your server's public URL)
# Must be accessible from the internet for Twilio to reach it
TWILIO_WEBHOOK_URL=https://maikr.pro

# Default agent ID to use when phone number isn't found in DB
DEFAULT_TWILIO_AGENT_ID=

# ── Slack ────────────────────────────────────
# Create a Slack App at api.slack.com/apps
# Bot scopes needed: chat:write, commands, app_mentions:read, messages:read
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your_signing_secret_here
SLACK_APP_ID=Axxxxxxxxxx

# Default agent ID for Slack workspace
DEFAULT_SLACK_AGENT_ID=

# ── API Base URL ──────────────────────────────
# Used by webhook handlers to call the internal swarm agent engine
# Change to your public domain for production
API_BASE_URL=http://127.0.0.1:3001
