generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rank {
  ENSIGN
  LIEUTENANT
  COMMANDER
  CAPTAIN
  ADMIRAL
}

enum MissionStatus {
  AVAILABLE
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum MissionType {
  SURVEILLANCE
  LOGISTICS
  REPAIR
  EXPLORATION
  CRISIS
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXTREME
}

enum AgentStatus {
  IDLE
  WORKING
  COMPLETED
  FAILED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  username     String            @unique
  passwordHash String
  rank         Rank              @default(ENSIGN)
  xp           Int               @default(0)
  profile      Profile?
  missions     Mission[]
  achievements UserAchievement[]
  memories     Memory[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  Agent        Agent[]
}

model Profile {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar      String?
  bio         String?
  preferences Json?
}

model Mission {
  id          String        @id @default(cuid())
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  status      MissionStatus @default(AVAILABLE)
  type        MissionType
  difficulty  Difficulty
  rewards     Json          @default("{}")
  progress    Json          @default("{}")
  startTime   DateTime?
  endTime     DateTime?
  zoneId      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  Task        Task[]
}

model NPC {
  id              String   @id @default(cuid())
  name            String
  role            String
  zoneId          String
  positionX       Int
  positionY       Int
  spriteKey       String
  defaultDialogue String?
  dialogueTree    Json     @default("{}")
  gifts           String[] @default([])
  schedule        Json?
}

model Zone {
  id          String @id @default(cuid())
  name        String @unique
  type        String
  background  String
  width       Int
  height      Int
  spawnX      Int
  spawnY      Int
  connections Json   @default("[]")
}

model Achievement {
  id          String            @id @default(cuid())
  name        String            @unique
  description String
  icon        String
  xpReward    Int
  conditions  Json              @default("{}")
  users       UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
}

model Agent {
  id          String      @id @default(cuid())
  name        String
  type        String // e.g., "scout", "miner", "combat", "diplomat"
  status      AgentStatus @default(IDLE)
  level       Int         @default(1)
  xp          Int         @default(0)
  health      Int         @default(100)
  maxHealth   Int         @default(100)
  attack      Int         @default(10)
  defense     Int         @default(10)
  speed       Int         @default(10)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentTask Task?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Task {
  id            String     @id @default(cuid())
  title         String
  description   String
  status        TaskStatus @default(PENDING)
  progress      Int        @default(0)
  maxProgress   Int        @default(100)
  xpReward      Int        @default(0)
  creditsReward Int        @default(0)
  missionId     String?
  mission       Mission?   @relation(fields: [missionId], references: [id], onDelete: SetNull)
  agentId       String     @unique
  agent         Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Memory {
  id        String   @id @default(cuid())
  content   String
  type      String
  metadata  Json?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, type])
}
