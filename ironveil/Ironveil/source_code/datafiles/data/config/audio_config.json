    "amb_ashspine":          { "description": "Howling wind, distant rockfall, cracking ice" },
    "amb_coast":             { "description": "Waves, seagulls, creaking ship hulls, buoy bell" },
    "amb_scorchlands":       { "description": "Dry wind, rattling debris, eerie silence" },
    "amb_spire_wastes":      { "description": "Cavernous echoes, dripping water, structural creaking" },
    "amb_grand_spire":       { "description": "Deep silence, electrical hum, ancient machines breathing" },
    "amb_bunker":            { "description": "Echoing corridors, dripping water, distant machinery" }
