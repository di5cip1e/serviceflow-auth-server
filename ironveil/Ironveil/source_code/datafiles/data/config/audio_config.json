{
  "_meta": {
    "description": "Master audio configuration. Defines all music tracks, SFX, ambience, dynamic layers, and volume defaults.",
    "version": "1.0"
  },

  "settings_defaults": {
    "master": 0.8,
    "music": 0.7,
    "ambient": 0.6,
    "sfx": 0.9,
    "ui": 0.8,
    "dialogue": 0.9
  },

  "crossfade_frames": 120,
  "layer_crossfade_frames": 60,
  "max_concurrent_sfx": 8,

  "music_tracks": {
    "mus_title_theme":              { "description": "Main theme — title screen, key story moments, end credits" },
    "mus_coppervale_spring":        { "description": "Coppervale Spring — flute, birdsong ornaments, light percussion" },
    "mus_coppervale_summer":        { "description": "Coppervale Summer — fuller strings, bright strumming" },
    "mus_coppervale_autumn":        { "description": "Coppervale Autumn — accordion lead, cello warmth, slower tempo" },
    "mus_coppervale_winter":        { "description": "Coppervale Winter — piano lead, music box texture, warm strings" },
    "mus_workshop_spring":          { "description": "Workshop Spring — standard bright, productive" },
    "mus_workshop_summer":          { "description": "Workshop Summer — faster tempo, more percussion, brass" },
    "mus_workshop_autumn":          { "description": "Workshop Autumn — moodier, minor key moments" },
    "mus_workshop_winter":          { "description": "Workshop Winter — warmest arrangement, refuge feel" },
    "mus_the_overlook":             { "description": "The Overlook — solo piano and cello, minimalist" },
    "mus_the_hollow":               { "description": "The Hollow — solo flute, ambient strings, harp, distant piano" },
    "mus_rustwood":                 { "description": "Rustwood — muted cello, metallic resonance, woodwind whispers" },
    "mus_ashspine":                 { "description": "Ashspine — French horn, sustained strings, deep drums" },
    "mus_shattered_coast":          { "description": "Shattered Coast — accordion, guitar, ship-bell percussion" },
    "mus_scorchlands":              { "description": "Scorchlands — lone cello, hollow metallic percussion, droning strings" },
    "mus_spire_wastes":             { "description": "Spire Wastes — restrained orchestra, wordless choir, fragmented piano" },
    "mus_grand_spire":              { "description": "Grand Spire — builds from ambient to full orchestra + choir" },
    "mus_they_come":                { "description": "Raid Preparation — low strings tremolo, distant war drums" },
    "mus_hold_the_line":            { "description": "Standard Raid — driving percussion, aggressive cello, brass stabs" },
    "mus_iron_march":               { "description": "Iron Marauder Raids — military snare, cold brass march" },
    "mus_the_siege":                { "description": "Major Siege — full orchestra, war drums, choir" },
    "mus_mech_deployed":            { "description": "Mech Combat — heavy percussion, driving bass, heroic brass" },
    "mus_the_marshal":              { "description": "Boss: The Marshal — brass leitmotif, war drums, choir, piano" },
    "mus_spark_festival":           { "description": "Spark Festival — upbeat accordion, fiddle, tambourine, brass fanfares" },
    "mus_sky_day":                  { "description": "Sky Day — soaring flute, strings, harp arpeggios" },
    "mus_harvest_faire":            { "description": "Harvest Faire — acoustic guitar, accordion waltz, cello" },
    "mus_remembrance":              { "description": "Remembrance Day — solo cello, piano, soft wordless choir" },
    "mus_old_world":                { "description": "Memory Scenes — music box, reverbed strings, piano fragments" },
    "mus_the_weight":               { "description": "Heavy Revelations — low strings, solo cello, silence between phrases" },
    "mus_heart_to_heart":           { "description": "Romance Scenes — piano and cello duet, acoustic guitar" },
    "mus_victory":                  { "description": "Post-Battle — warmest main theme, celebratory percussion" },
    "mus_the_apex":                 { "description": "Climactic Revelation — full orchestra, choir, unison main theme" }
  },

