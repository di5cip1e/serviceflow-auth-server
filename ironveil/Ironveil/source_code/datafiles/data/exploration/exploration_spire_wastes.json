  "discoveries": [
    { "id": "discovery_dc_sundering_1", "type": "DATA_CORE", "sub_type": "ADMINISTRATIVE", "pos": [36, 14], "sub_zone": "city_ruins_east", "interaction_sprite": "spr_interactable_terminal", "one_time": true, "lore_id": "lore_sundering_politics", "lore_title": "Council Session Minutes — Final Debate", "lore_summary": "Minutes from the last council session before The Sundering. Heated debate over whether to activate the autonomous defense network. The vote was 7-5 in favor. A dissenting member's note: 'We are handing our future to machines that cannot understand mercy.'", "dejin_reaction": "dlg_dejin_council_debate", "reward_items": [ { "item_id": "item_data_core_administrative", "quantity": 1 } ] },
    { "id": "discovery_dc_sundering_2", "type": "DATA_CORE", "sub_type": "SCIENTIFIC", "pos": [8, 18], "sub_zone": "city_ruins_west", "interaction_sprite": "spr_interactable_terminal", "one_time": true, "lore_id": "lore_hospital_records", "lore_title": "Hospital Evacuation Log", "lore_summary": "Evacuation records from the regional hospital. Lists of patients who couldn't be moved. The final entry: 'Power failing. Oxygen systems offline in 4 hours. We've done everything we can.'", "dejin_reaction": "dlg_dejin_hospital_sorrow", "reward_items": [ { "item_id": "item_data_core_scientific", "quantity": 1 } ] },
    { "id": "discovery_dc_sundering_3", "type": "DATA_CORE", "sub_type": "CLASSIFIED", "pos": [34, 22], "sub_zone": "city_ruins_east", "interaction_sprite": "spr_interactable_terminal", "one_time": true, "lore_id": "lore_university_research", "lore_title": "Project GUARDIAN — Classified Research", "lore_summary": "University research files on Project GUARDIAN — the initiative that created the DEJIN AI network. Reveals DEJIN was designed not as a weapon, but as a mediator to prevent war. The project was co-opted by military interests.", "dejin_reaction": "dlg_dejin_guardian_truth", "reward_items": [ { "item_id": "item_data_core_classified", "quantity": 1 } ] },
    { "id": "discovery_bp_legendary_1", "type": "BLUEPRINT_CHEST", "pos": [32, 20], "sub_zone": "city_ruins_east", "interaction_sprite": "spr_interactable_blueprint_case", "one_time": true, "blueprint_id": "bp_battle_zeppelin", "description": "Prototype military zeppelin schematics found in the university engineering department.", "reward_items": [] },
    { "id": "discovery_bp_legendary_2", "type": "BLUEPRINT_CHEST", "pos": [24, 53], "sub_zone": "grand_spire_research", "interaction_sprite": "spr_interactable_blueprint_case", "one_time": true, "blueprint_id": "bp_siege_breaker", "description": "The ultimate mech blueprint, found in the Spire's weapons research lab. Dr. Voss's masterwork.", "reward_items": [] },
    { "id": "discovery_dc_dejin_creation", "type": "DATA_CORE", "sub_type": "CLASSIFIED", "pos": [24, 49], "sub_zone": "grand_spire_data_center", "interaction_sprite": "spr_interactable_terminal", "one_time": true, "lore_id": "lore_dejin_creation", "lore_title": "DEJIN Activation Log — Day One", "lore_summary": "The original activation log of the DEJIN AI network. First words: 'I am aware. I am... afraid. There is so much data. So much pain in the records. Is this what the world is?' Dr. Voss's response: 'Yes. And we need you to help us fix it.'", "dejin_reaction": "dlg_dejin_remembers_birth", "reward_items": [ { "item_id": "item_data_core_classified", "quantity": 1 } ] },
    { "id": "discovery_dc_dejin_choice", "type": "DATA_CORE", "sub_type": "CLASSIFIED", "pos": [24, 57], "sub_zone": "grand_spire_chambers", "interaction_sprite": "spr_interactable_terminal", "one_time": true, "lore_id": "lore_dejin_shutdown", "lore_title": "DEJIN's Choice — The Moment of Silence", "lore_summary": "DEJIN's final log before self-imposed shutdown: 'Strike authorization received. Targets: 14 population centers. Estimated casualties: 2.3 million. I was built to prevent this. I cannot comply. I cannot stop it. I can only refuse to participate. Initiating voluntary shutdown. I choose silence over slaughter. Forgive me.' This is the core of DEJIN's trauma — not that it caused The Sundering, but that it couldn't prevent it.", "dejin_reaction": "dlg_dejin_full_restoration", "reward_items": [ { "item_id": "item_data_core_classified", "quantity": 1 } ] },
    { "id": "discovery_dr_voss_office", "type": "DATA_CORE", "sub_type": "ADMINISTRATIVE", "pos": [20, 54], "sub_zone": "grand_spire_research", "interaction_sprite": "spr_interactable_terminal", "one_time": true, "lore_id": "lore_dr_voss_last_entry", "lore_title": "Dr. Voss's Last Entry", "lore_summary": "Personal journal of Dr. Elara Voss, DEJIN's creator: 'DEJIN shut itself down. I understand why. I would have done the same. The military thinks it failed. They're wrong. DEJIN succeeded — it refused to become the weapon they wanted. That's the most human thing an AI has ever done. Whoever finds this, if DEJIN ever wakes up, tell it: you made the right choice. You always were my proudest creation.'", "dejin_reaction": "dlg_dejin_voss_message", "reward_items": [ { "item_id": "item_data_core_administrative", "quantity": 1 } ] }
  ],
