  "collision_rules": {
    "types": {
      "0": "WALKABLE",
      "1": "BLOCKED",
      "2": "INTERACTABLE",
      "3": "TRANSITION",
      "4": "WATER_SHALLOW",
      "5": "DEFENSE_ZONE"
    },
    "general": [
      "All building footprints are BLOCKED (1) except door tiles which are INTERACTABLE (2)",
      "River cols 0-3 are BLOCKED (1), cols 4-5 are WATER_SHALLOW (4), cols 6-7 are WALKABLE (0) riverbank",
      "Tree trunks are BLOCKED (1)",
      "Fence tiles are BLOCKED (1) except gate tiles which are WALKABLE (0)",
      "All outer edge tiles are BLOCKED (1) unless designated TRANSITION (3)",
      "Eastern Gate area, field positions, workshop perimeter, southern treeline have DEFENSE_ZONE (5) tiles"
    ]
  },

