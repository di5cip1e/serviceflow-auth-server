# Station Command - Environment Variables Template
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://station_user:your_password_here@localhost:5432/station_command"

# =============================================================================
# AUTHENTICATION (NextAuth.js)
# =============================================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your_nextauth_secret_here_generate_with_openssl"

# URL for production (change for Railway)
NEXTAUTH_URL="http://localhost:3000"

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV="development"

# =============================================================================
# POSTGRES (Local Development)
# =============================================================================
POSTGRES_USER="station_user"
POSTGRES_PASSWORD="dev_password_change_this"
POSTGRES_DB="station_command"
POSTGRES_PORT="5432"

# =============================================================================
# OPTIONAL: External Services
# =============================================================================
# Add your external service API keys here as needed
# Example: OPENAI_API_KEY="sk-..."
# Example: STRIPE_SECRET_KEY="sk_..."
