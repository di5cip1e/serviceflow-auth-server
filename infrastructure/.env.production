# Station Command - Production Environment Variables
# Copy this file to .env and fill in actual values
# NEVER commit this file to git!

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# Example: postgresql://station_user:SecureP@ss123@db.example.com:5432/station_command
DATABASE_URL="postgresql://station_user:CHANGE_ME@localhost:5432/station_command"

# =============================================================================
# AUTHENTICATION (NextAuth.js)
# =============================================================================
# Generate with: openssl rand -base64 32
# This is critical for security - use a strong, unique secret
NEXTAUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"

# Production URL (no trailing slash)
# Example: https://station-command.example.com
NEXTAUTH_URL="https://your-domain.com"

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV="production"

# =============================================================================
# POSTGRES (Local Docker Development)
# =============================================================================
# These are used by docker-compose.yml for local dev only
POSTGRES_USER="station_user"
POSTGRES_PASSWORD="dev_password_change_this"
POSTGRES_DB="station_command"
POSTGRES_PORT="5432"

# =============================================================================
# REDIS (Optional - for sessions/caching)
# =============================================================================
# Format: redis://username:password@host:port
# Example: redis://:redis_password@redis.example.com:6379
REDIS_URL="redis://localhost:6379"

# =============================================================================
# QDRANT (Vector Database - Optional)
# =============================================================================
# Format: http://host:port
# Example: http://qdrant.example.com:6333
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""

# =============================================================================
# EXTERNAL SERVICES (Add as needed)
# =============================================================================
# OPENAI_API_KEY="sk-..."
# STRIPE_SECRET_KEY="sk_..."
# SENTRY_DSN="https://..."
