generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Doer {
  id           Int          @id @default(autoincrement())
  name         String
  role         String       @default("resident") // admin, resident
  completions  Int          @default(0)
  refusals     Int          @default(0)
  assignments  Assignment[]
}

model Chore {
  id               Int          @id @default(autoincrement())
  name             String
  description      String       @default("")
  difficulty_rating Int         @default(1)
  steps            Step[]
  assignments      Assignment[]
}

model Step {
  id            Int    @id @default(autoincrement())
  choreId        Int
  text           String
  sequence_order Int
  chore          Chore  @relation(fields: [choreId], references: [id], onDelete: Cascade)

  @@index([choreId])
}

model Assignment {
  id           Int       @id @default(autoincrement())
  doerId       Int
  choreId      Int
  assignedDate DateTime  @default(now())
  dueDate      DateTime?
  status       String    @default("pending") // pending, completed, approved, rejected, refused
  completedAt  DateTime?
  approvedAt   DateTime?
  approvedBy   Int?      // doerId of admin who approved
  notes        String    @default("")
  doer         Doer      @relation(fields: [doerId], references: [id], onDelete: Cascade)
  chore        Chore     @relation(fields: [choreId], references: [id], onDelete: Cascade)

  @@index([doerId])
  @@index([choreId])
  @@index([dueDate])
  @@index([status])
}
