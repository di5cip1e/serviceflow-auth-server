generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Doer {
  id           Int          @id @default(autoincrement())
  name         String
  completions  Int          @default(0)
  refusals     Int          @default(0)
  assignments  Assignment[]
}

model Chore {
  id               Int          @id @default(autoincrement())
  name             String
  description      String       @default("")
  difficulty_rating Int         @default(1)
  steps            Step[]
  assignments      Assignment[]
}

model Step {
  id            Int    @id @default(autoincrement())
  choreId        Int
  text           String
  sequence_order Int
  chore          Chore  @relation(fields: [choreId], references: [id], onDelete: Cascade)

  @@index([choreId])
}

model Assignment {
  id           Int      @id @default(autoincrement())
  doerId       Int
  choreId      Int
  assignedDate DateTime @default(now())
  status       String   @default("Pending") // Pending, Completed, Refused
  doer         Doer     @relation(fields: [doerId], references: [id], onDelete: Cascade)
  chore        Chore    @relation(fields: [choreId], references: [id], onDelete: Cascade)

  @@index([doerId])
  @@index([choreId])
}
